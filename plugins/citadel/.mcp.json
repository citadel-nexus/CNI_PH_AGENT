{
  "memory-store": {
    "type": "stdio",
    "command": "npx",
    "args": ["-y", "@anthropic-ai/mcp-memory"],
    "env": {
      "MEMORY_STORE_PATH": "~/.citadel/memory-store.json"
    }
  },
  "datadog": {
    "type": "stdio",
    "command": "npx",
    "args": ["-y", "@anthropic-ai/mcp-datadog"],
    "env": {
      "DD_API_KEY": "${DD_API_KEY}",
      "DD_SITE": "${DD_SITE:-us5.datadoghq.com}"
    }
  },
  "notion": {
    "type": "stdio",
    "command": "npx",
    "args": ["-y", "@anthropic-ai/mcp-notion"],
    "env": {
      "NOTION_TOKEN": "${NOTION_TOKEN}"
    }
  },
  "linear": {
    "type": "stdio",
    "command": "npx",
    "args": ["-y", "@anthropic-ai/mcp-linear"],
    "env": {
      "LINEAR_API_KEY": "${LINEAR_API_KEY}"
    }
  },
  "n8n": {
    "type": "stdio",
    "command": "npx",
    "args": ["-y", "@anthropic-ai/mcp-n8n"],
    "env": {
      "N8N_API_URL": "${N8N_API_URL}",
      "N8N_API_KEY": "${N8N_API_KEY}"
    }
  }
}